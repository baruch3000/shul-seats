{
  "name": "shul-seats",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --use-system-ca ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "seed": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/seed.ts",
    "seed:force": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/seed.ts --force",
    "sync:blocked": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/sync-blocked.ts",
    "health": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/check-health.ts",
    "generate:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "test:smoke": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/e2e-smoke.ts",
    "layout:generate": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/generate-layout.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^2.4.3",
    "jose": "^6.0.10",
    "lucide-react": "^0.487.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-zoom-pan-pinch": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
