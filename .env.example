# === Supabase (Settings → API) ===
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Keys may be legacy JWT (eyJ...) or new format (sb_publishable_ / sb_secret_)

# === Google OAuth (Cloud Console → Credentials) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Auth.js / NextAuth ===
# Local dev:
AUTH_URL=http://localhost:3000
# Production (REQUIRED for go-live — must match your domain exactly):
# AUTH_URL=https://seats.yourshul.org
AUTH_SECRET=generate-a-long-random-string-at-least-32-chars
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Legacy aliases (optional — AUTH_* preferred)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

ADMIN_INITIAL_PASSWORD=ShulSeats2026!

# === Production checklist ===
# 1. Deploy to Vercel (or similar) with HTTPS
# 2. Set all env vars in hosting dashboard
# 3. Google Console → Authorized redirect URI:
#    https://YOUR_DOMAIN/api/auth/callback/google
# 4. Run: npm run seed (once, after migration)
# 5. Run: npm run health — all checks must pass
